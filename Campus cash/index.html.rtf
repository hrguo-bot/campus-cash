\f0\fs24 \cf0 <!DOCTYPE html>\
<html lang="en">\
<head>\
  <meta charset="UTF-8"/>\
  <!-- PWA Meta Tags -->\
<meta name="theme-color" content="#6C63FF"/>\
<meta name="apple-mobile-web-app-capable" content="yes"/>\
<meta name="apple-mobile-web-app-status-bar-style" content="default"/>\
<meta name="apple-mobile-web-app-title" content="Campus Cash"/>\
<link rel="manifest" href="manifest.json"/>\
<link rel="apple-touch-icon" href="icon.png"/>\
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>\
  <title>Campus Cash \uc0\u55357 \u56496 </title>\
  <style>\
    *, *::before, *::after \{ box-sizing: border-box; margin: 0; padding: 0; \}\
    :root \{\
      --primary:#6C63FF; --pdark:#5A52D5;\
      --success:#00B894; --warning:#FDCB6E;\
      --danger:#FF4757;  --dark:#2D3748;\
      --mid:#4A5568;     --muted:#718096;\
      --faint:#A0AEC0;   --bg:#EEF2F7;\
      --card:#FFFFFF;    --border:#E2E8F0;\
    \}\
    body \{ font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;\
      background:var(--bg); color:var(--dark); min-height:100vh; \}\
    .screen \{ display:none; min-height:100vh; \}\
    .screen.active \{ display:block; \}\
\
    /* \uc0\u9472 \u9472  HEADER \u9472 \u9472  */\
    .header \{ background:linear-gradient(135deg,var(--primary),var(--pdark));\
      color:#fff; padding:14px 20px; position:sticky; top:0; z-index:50;\
      box-shadow:0 2px 14px rgba(108,99,255,.35); \}\
    .hd-inner \{ max-width:480px; margin:0 auto;\
      display:flex; justify-content:space-between; align-items:center; \}\
    .hd-title \{ font-size:1.2rem; font-weight:700; \}\
    .hd-sub \{ font-size:.73rem; opacity:.75; margin-top:1px; \}\
    .hd-btn \{ background:rgba(255,255,255,.2); border:none; color:#fff;\
      padding:6px 12px; border-radius:8px; font-size:.78rem; cursor:pointer; \}\
    .hd-btn:hover \{ background:rgba(255,255,255,.32); \}\
\
    /* \uc0\u9472 \u9472  LAYOUT \u9472 \u9472  */\
    .content \{ max-width:480px; margin:0 auto; padding:20px 18px 110px; \}\
\
    /* \uc0\u9472 \u9472  CARDS \u9472 \u9472  */\
    .card \{ background:var(--card); border-radius:16px; padding:20px;\
      margin-bottom:14px; box-shadow:0 1px 8px rgba(0,0,0,.07); \}\
    .card h2 \{ font-size:1.2rem; margin-bottom:6px; \}\
    .card p \{ color:var(--muted); font-size:.87rem; margin-bottom:14px; line-height:1.5; \}\
    .sec-hd \{ font-size:.9rem; font-weight:700; color:var(--dark);\
      display:flex; align-items:center; gap:7px; margin-bottom:10px; \}\
    .divider \{ border:none; border-top:2px dashed var(--border); margin:16px 0; \}\
\
    /* \uc0\u9472 \u9472  BUTTONS \u9472 \u9472  */\
    .btn \{ display:block; width:100%; padding:13px 18px; border:none;\
      border-radius:12px; font-size:.97rem; font-weight:600;\
      cursor:pointer; text-align:center; transition:all .15s; \}\
    .btn:active \{ transform:scale(.98); \}\
    .btn-primary \{ background:linear-gradient(135deg,var(--primary),var(--pdark));\
      color:#fff; box-shadow:0 4px 14px rgba(108,99,255,.35); \}\
    .btn-ghost \{ background:var(--bg); color:var(--mid);\
      border:2px solid var(--border); margin-top:8px; \}\
    .btn-sm \{ padding:6px 13px; font-size:.77rem; border-radius:8px;\
      width:auto; display:inline-block; \}\
    .btn-del \{ background:none; border:none; font-size:.84rem;\
      cursor:pointer; color:var(--faint); padding:4px 6px; border-radius:6px; \}\
    .btn-del:hover \{ background:#FFE0E0; color:var(--danger); \}\
    .btn-text \{ background:none; border:none; color:var(--faint);\
      font-size:.83rem; cursor:pointer; padding:8px 14px; border-radius:8px; \}\
    .btn-text:hover \{ color:var(--danger); background:#fff0f0; \}\
\
    /* \uc0\u9472 \u9472  SAME-AS-LAST \u9472 \u9472  */\
    .same-btn \{ width:100%; padding:11px 14px;\
      background:linear-gradient(135deg,#EDFAF3,#D1F5E4);\
      border:2px solid #B8DFCA; border-radius:11px;\
      color:#155724; font-size:.83rem; font-weight:600;\
      cursor:pointer; text-align:left; margin-bottom:9px;\
      display:flex; align-items:center; gap:8px; \}\
    .same-btn:hover \{ filter:brightness(.97); \}\
    .sb-val \{ margin-left:auto; background:#155724; color:#fff;\
      padding:2px 8px; border-radius:6px; font-size:.72rem; white-space:nowrap; \}\
    .or-row \{ display:flex; align-items:center; gap:10px;\
      margin:6px 0 12px; color:var(--faint); font-size:.75rem; \}\
    .or-row::before,.or-row::after \{ content:''; flex:1; height:1px; background:var(--border); \}\
\
    /* \uc0\u9472 \u9472  FIELDS \u9472 \u9472  */\
    .field \{ margin-bottom:13px; \}\
    .field label \{ display:block; font-size:.72rem; font-weight:700;\
      text-transform:uppercase; letter-spacing:.6px; color:var(--muted); margin-bottom:6px; \}\
    .field input,.field select \{ width:100%; padding:12px 14px;\
      border:2px solid var(--border); border-radius:10px;\
      font-size:1rem; color:var(--dark); background:#fff;\
      transition:border-color .2s; appearance:none; \}\
    .field input:focus,.field select:focus \{ outline:none; border-color:var(--primary); \}\
    .field.money \{ position:relative; \}\
    .field.money::before \{ content:'$'; position:absolute; left:14px; bottom:13px;\
      color:var(--muted); pointer-events:none; \}\
    .field.money input \{ padding-left:26px; \}\
    .field.pts \{ position:relative; \}\
    .field.pts::after \{ content:'pts'; position:absolute; right:14px; bottom:13px;\
      color:var(--muted); pointer-events:none; font-size:.82rem; \}\
    .field.pts input \{ padding-right:44px; \}\
\
    /* \uc0\u9472 \u9472  STEP DOTS \u9472 \u9472  */\
    .steps \{ display:flex; justify-content:center; gap:6px; margin-bottom:20px; \}\
    .step \{ height:6px; width:6px; border-radius:3px;\
      background:var(--border); transition:all .3s; \}\
    .step.active \{ width:22px; background:var(--primary); \}\
    .step.done   \{ background:var(--success); \}\
\
    /* \uc0\u9472 \u9472  ALLOC BAR \u9472 \u9472  */\
    .alloc-box \{ background:var(--card); border:2px solid var(--border);\
      border-radius:14px; padding:14px; margin-bottom:12px; \}\
    .alloc-top \{ display:flex; justify-content:space-between;\
      align-items:flex-start; margin-bottom:10px; \}\
    .alloc-pct-num \{ font-size:2rem; font-weight:800; color:var(--primary); line-height:1; \}\
    .alloc-pct-lbl \{ font-size:.7rem; color:var(--muted); \}\
    .alloc-r \{ text-align:right; \}\
    .alloc-dlr \{ font-size:1.05rem; font-weight:700; \}\
    .alloc-dlr-sub \{ font-size:.7rem; color:var(--muted); \}\
    .pbar \{ background:var(--bg); border-radius:20px; overflow:hidden; \}\
    .pb7  \{ height:7px; \}\
    .pb10 \{ height:10px; \}\
    .pbar-fill \{ height:100%; border-radius:20px; transition:width .4s; \}\
    .alloc-foot \{ display:flex; justify-content:space-between;\
      font-size:.73rem; margin-top:7px; \}\
\
    /* \uc0\u9472 \u9472  ADD CAT ROW \u9472 \u9472  */\
    .add-row \{ display:flex; gap:8px; margin-bottom:10px; \}\
    .add-row input \{ flex:1; padding:10px 12px;\
      border:2px solid var(--border); border-radius:10px; font-size:.9rem; color:var(--dark); \}\
    .add-row input:focus \{ outline:none; border-color:var(--primary); \}\
    .add-row button \{ padding:10px 16px; background:var(--primary); color:#fff;\
      border:none; border-radius:10px; cursor:pointer; font-size:1.1rem; \}\
\
    /* \uc0\u9472 \u9472  SETUP CAT ROW \u9472 \u9472  */\
    .sc-row \{ display:flex; align-items:center; gap:5px;\
      background:var(--bg); border-radius:11px; padding:8px 10px;\
      margin-bottom:7px; border:1px solid var(--border); \}\
    .sc-row:focus-within \{ border-color:var(--primary); background:#F8F7FF; \}\
    .sc-ico \{ font-size:1.1rem; flex-shrink:0; \}\
    .sc-nm  \{ flex:1; font-size:.81rem; font-weight:600; min-width:0;\
      overflow:hidden; text-overflow:ellipsis; white-space:nowrap; \}\
\
    /* \uc0\u9472 \u9472  5% STEPPER \u9472 \u9472  */\
    .stepper \{ display:flex; align-items:center; flex-shrink:0; \}\
    .sp-btn \{ width:27px; height:31px;\
      border:2px solid var(--border); background:var(--bg);\
      color:var(--mid); font-size:1rem; font-weight:700;\
      cursor:pointer; display:flex; align-items:center; justify-content:center;\
      user-select:none; transition:all .15s; line-height:1; \}\
    .sp-btn.minus \{ border-radius:7px 0 0 7px; border-right:none; \}\
    .sp-btn.plus  \{ border-radius:0 7px 7px 0; border-left:none; \}\
    .sp-btn:hover \{ background:var(--primary); color:#fff; border-color:var(--primary); \}\
    .sp-btn:active \{ transform:scale(.9); \}\
    .sp-inp \{ width:42px; height:31px; text-align:center;\
      border:2px solid var(--border); border-radius:0;\
      font-size:.9rem; font-weight:700; color:var(--primary); background:#fff; padding:0; \}\
    .sp-inp:focus \{ outline:none; border-color:var(--primary); background:#F0EEFF; \}\
    .sp-sym \{ font-size:.78rem; color:var(--muted); margin-left:3px; \}\
    .sc-arrow \{ font-size:.68rem; color:var(--faint); margin:0 1px; \}\
    .sc-calc \{ font-size:.77rem; font-weight:700; color:#00896F;\
      background:#EDFAF3; padding:3px 6px; border-radius:6px;\
      min-width:54px; text-align:right; flex-shrink:0; \}\
    .sc-calc.zero \{ color:var(--faint); background:var(--bg); \}\
    .sc-scroll \{ max-height:280px; overflow-y:auto; padding-right:2px; \}\
    .sc-scroll::-webkit-scrollbar \{ width:4px; \}\
    .sc-scroll::-webkit-scrollbar-thumb \{ background:var(--border); border-radius:2px; \}\
\
    /* \uc0\u9472 \u9472  HINT \u9472 \u9472  */\
    .hint \{ display:flex; align-items:flex-start; gap:7px; font-size:.73rem;\
      color:var(--muted); background:#F8F7FF; border-radius:8px;\
      padding:8px 10px; margin-bottom:10px; line-height:1.45; \}\
\
    /* \uc0\u9472 \u9472  HERO \u9472 \u9472  */\
    .hero \{ background:linear-gradient(135deg,var(--primary),var(--pdark));\
      color:#fff; border-radius:20px; padding:22px; margin-bottom:12px;\
      box-shadow:0 8px 24px rgba(108,99,255,.35); transition:background .4s; \}\
    .hero-lbl \{ font-size:.78rem; opacity:.8; margin-bottom:4px; \}\
    .hero-amt \{ font-size:2.4rem; font-weight:800; letter-spacing:-1px;\
      line-height:1; margin-bottom:16px; \}\
    .hero-grid \{ display:grid; grid-template-columns:1fr 1fr; gap:9px; \}\
    .hero-item \{ background:rgba(255,255,255,.15); border-radius:12px; padding:10px 12px; \}\
    .hi-lbl \{ font-size:.69rem; opacity:.8; \}\
    .hi-val \{ font-size:1rem; font-weight:700; margin-top:3px; \}\
    .hero-ovr \{ background:rgba(255,71,87,.32); border-radius:10px;\
      padding:7px 12px; font-size:.75rem; margin-top:10px;\
      display:flex; align-items:center; gap:6px; \}\
\
    /* \uc0\u9472 \u9472  MINI CARDS \u9472 \u9472  */\
    .mini-row \{ display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:13px; \}\
    .a-card \{ background:linear-gradient(135deg,#00B894,#00896F);\
      color:#fff; border-radius:16px; padding:14px;\
      box-shadow:0 4px 16px rgba(0,184,148,.28); \}\
    .ac-lbl \{ font-size:.69rem; opacity:.85; margin-bottom:4px; \}\
    .ac-amt \{ font-size:1.22rem; font-weight:800; line-height:1; \}\
    .ac-rows \{ font-size:.64rem; opacity:.9; margin-top:8px; \}\
    .ac-row  \{ display:flex; justify-content:space-between; padding:1.5px 0; \}\
    .ac-neg  \{ color:#FFD3D3; \}\
    .ac-addbtn \{ background:rgba(255,255,255,.22); border:none; color:#fff;\
      padding:5px; border-radius:6px; font-size:.68rem; font-weight:700;\
      cursor:pointer; margin-top:9px; display:block; width:100%; text-align:center; \}\
    .ac-addbtn:hover \{ background:rgba(255,255,255,.35); \}\
    .d-card \{ border-radius:16px; padding:14px; color:#fff; \}\
    .d-card.ok    \{ background:linear-gradient(135deg,#e17055,#c0392b);\
      box-shadow:0 4px 16px rgba(192,57,43,.28); \}\
    .d-card.empty \{ background:linear-gradient(135deg,#b2bec3,#636e72); \}\
    .dc-lbl \{ font-size:.69rem; opacity:.85; margin-bottom:4px; \}\
    .dc-amt \{ font-size:1.22rem; font-weight:800; line-height:1; \}\
    .dc-sub \{ font-size:.66rem; opacity:.85; margin-top:3px; \}\
    .dc-bar-wrap \{ margin-top:9px; \}\
    .dc-bar \{ background:rgba(255,255,255,.25); border-radius:20px; height:5px; overflow:hidden; \}\
    .dc-bar-fill \{ height:100%; border-radius:20px;\
      background:rgba(255,255,255,.8); transition:width .4s; \}\
    .dc-pct \{ font-size:.64rem; opacity:.85; margin-top:3px; \}\
\
    /* \uc0\u9472 \u9472  TABS \u9472 \u9472  */\
    .nav-tabs \{ display:flex; background:#fff; border-radius:13px;\
      padding:4px; margin-bottom:16px; box-shadow:0 1px 6px rgba(0,0,0,.06); \}\
    .ntab \{ flex:1; padding:9px; border:none; background:none;\
      border-radius:10px; font-size:.83rem; font-weight:600;\
      color:var(--muted); cursor:pointer; transition:all .2s; \}\
    .ntab.active \{ background:var(--primary); color:#fff; \}\
\
    /* \uc0\u9472 \u9472  CATEGORY CARDS \u9472 \u9472  */\
    .cat-card \{ background:#fff; border-radius:13px; padding:13px 15px;\
      margin-bottom:9px; border-left:4px solid;\
      box-shadow:0 1px 5px rgba(0,0,0,.06); \}\
    .cc-top \{ display:flex; justify-content:space-between; align-items:flex-start; \}\
    .cc-left \{ display:flex; align-items:center; gap:8px; flex:1; min-width:0; \}\
    .cc-ico \{ font-size:1.1rem; flex-shrink:0; \}\
    .cc-info \{ min-width:0; \}\
    .cc-name \{ font-weight:600; font-size:.9rem;\
      display:flex; align-items:center; gap:4px; flex-wrap:wrap; \}\
    .cc-pct  \{ font-size:.66rem; font-weight:700; padding:2px 6px;\
      border-radius:20px; background:#EDE9FF; color:var(--primary); \}\
    .cc-alloc\{ font-size:.7rem; color:var(--muted); margin-top:2px; \}\
    .cc-right\{ text-align:right; flex-shrink:0; margin-left:8px; \}\
    .cc-rem  \{ font-size:.95rem; font-weight:700; \}\
    .cc-sub  \{ font-size:.7rem; color:var(--muted); margin-top:2px; \}\
    .badge   \{ display:inline-block; padding:2px 7px;\
      border-radius:20px; font-size:.66rem; font-weight:700; \}\
    .b-danger\{ background:#FFE0E0; color:var(--danger); \}\
    .b-warn  \{ background:#FFF5D6; color:#7B5B00; \}\
    .b-dining\{ background:#FFE8E0; color:#c0392b; \}\
\
    /* \uc0\u9472 \u9472  TRANSACTIONS \u9472 \u9472  */\
    .txn \{ display:flex; align-items:center; gap:11px;\
      padding:11px 0; border-bottom:1px solid var(--bg); \}\
    .txn:last-child \{ border-bottom:none; \}\
    .txn-ico \{ width:38px; height:38px; border-radius:10px;\
      display:flex; align-items:center; justify-content:center;\
      font-size:1rem; flex-shrink:0; \}\
    .txn-info \{ flex:1; min-width:0; \}\
    .txn-desc \{ font-weight:600; font-size:.86rem;\
      white-space:nowrap; overflow:hidden; text-overflow:ellipsis; \}\
    .txn-meta \{ font-size:.69rem; color:var(--muted); margin-top:2px; \}\
    .txn-right \{ display:flex; align-items:center; gap:5px; flex-shrink:0; \}\
    .amt-neg \{ font-weight:700; color:var(--danger);  font-size:.85rem; \}\
    .amt-pos \{ font-weight:700; color:var(--success); font-size:.85rem; \}\
    .amt-pts \{ font-weight:700; color:#e17055;        font-size:.85rem; \}\
\
    /* \uc0\u9472 \u9472  SECTION TITLE \u9472 \u9472  */\
    .sec-title \{ font-size:.75rem; font-weight:700;\
      text-transform:uppercase; letter-spacing:.5px; color:var(--muted);\
      margin-bottom:10px; display:flex; justify-content:space-between; align-items:center; \}\
\
    /* \uc0\u9472 \u9472  ALERTS \u9472 \u9472  */\
    .alert \{ padding:10px 13px; border-radius:9px;\
      font-size:.82rem; font-weight:500; margin-bottom:12px; line-height:1.45; \}\
    .a-ok   \{ background:#EDFAF3; color:#155724; border:1px solid #B8DFCA; \}\
    .a-warn \{ background:#FFF9E6; color:#7B5B00; border:1px solid #FDDFA0; \}\
    .a-err  \{ background:#FFF0F0; color:#9B2335; border:1px solid #FFB3B3; \}\
\
    /* \uc0\u9472 \u9472  EMPTY \u9472 \u9472  */\
    .empty \{ text-align:center; padding:32px 16px; color:var(--muted); \}\
    .empty-ico  \{ font-size:2.4rem; margin-bottom:10px; \}\
    .empty-text \{ font-size:.84rem; line-height:1.7; \}\
\
    /* \uc0\u9472 \u9472  EXPENSE TOGGLE \u9472 \u9472  */\
    .exp-toggle \{ display:flex; background:var(--bg); border-radius:11px;\
      padding:4px; margin-bottom:16px; \}\
    .et-btn \{ flex:1; padding:9px; border:none; background:none;\
      border-radius:8px; font-size:.83rem; font-weight:600;\
      color:var(--muted); cursor:pointer; transition:all .2s; \}\
    .et-btn.active \{ background:#fff; color:var(--dark);\
      box-shadow:0 1px 5px rgba(0,0,0,.1); \}\
\
    /* \uc0\u9472 \u9472  FAB \u9472 \u9472  */\
    #fab \{ position:fixed; bottom:24px; right:50%; transform:translateX(220px);\
      width:56px; height:56px; border-radius:50%;\
      background:linear-gradient(135deg,var(--primary),var(--pdark));\
      border:none; color:#fff; font-size:1.9rem;\
      cursor:pointer; display:none; align-items:center; justify-content:center;\
      box-shadow:0 6px 20px rgba(108,99,255,.52); z-index:90; transition:transform .2s; \}\
    #fab:hover  \{ transform:translateX(220px) scale(1.1); \}\
    #fab:active \{ transform:translateX(220px) scale(.95); \}\
    @media (max-width:480px) \{\
      #fab \{ right:20px; transform:none; \}\
      #fab:hover  \{ transform:scale(1.08); \}\
      #fab:active \{ transform:scale(.95); \}\
    \}\
\
    /* \uc0\u9472 \u9472  MODAL \u9472 \u9472  */\
    .modal-bg \{ display:none; position:fixed; inset:0;\
      background:rgba(0,0,0,.45); z-index:200;\
      align-items:flex-end; justify-content:center; \}\
    .modal-bg.open \{ display:flex; \}\
    .modal-box \{ background:#fff; border-radius:22px 22px 0 0;\
      padding:18px 20px 32px; width:100%; max-width:480px;\
      animation:slideUp .28s cubic-bezier(.34,1.56,.64,1); max-height:92vh; overflow-y:auto; \}\
    @keyframes slideUp \{\
      from \{ transform:translateY(100%); opacity:0; \}\
      to   \{ transform:translateY(0);    opacity:1; \}\
    \}\
    .modal-handle \{ width:34px; height:4px; background:var(--border);\
      border-radius:2px; margin:0 auto 16px; flex-shrink:0; \}\
    .modal-box h2 \{ font-size:1.1rem; margin-bottom:14px; \}\
\
    /* \uc0\u9472 \u9472  ACTION PICKER \u9472 \u9472  */\
    .action-list \{ display:flex; flex-direction:column; gap:9px; \}\
    .action-item \{ display:flex; align-items:center; gap:13px;\
      background:var(--bg); border:none; border-radius:12px;\
      padding:13px 15px; cursor:pointer; text-align:left;\
      font-size:.9rem; font-weight:600; color:var(--dark); transition:all .15s; \}\
    .action-item:hover  \{ background:#E8E6FF; \}\
    .action-item:active \{ transform:scale(.98); \}\
    .ai-ico \{ font-size:1.35rem; width:40px; height:40px;\
      border-radius:10px; display:flex; align-items:center;\
      justify-content:center; flex-shrink:0; \}\
    .ai-sub \{ font-size:.73rem; color:var(--muted); font-weight:400; margin-top:2px; \}\
\
    /* \uc0\u9472 \u9472  NEW MONTH SUMMARY \u9472 \u9472  */\
    .nm-sum \{ background:linear-gradient(135deg,var(--primary),var(--pdark));\
      color:#fff; border-radius:16px; padding:18px; margin-bottom:16px; \}\
    .nm-sum-lbl \{ font-size:.75rem; opacity:.8; margin-bottom:4px; \}\
    .nm-sum-amt \{ font-size:2rem; font-weight:800; margin-bottom:12px; \}\
    .nm-sum-rows \{ font-size:.77rem; opacity:.92; \}\
    .nm-sum-row \{ display:flex; justify-content:space-between; padding:3px 0; \}\
    .nm-info \{ font-size:.82rem; color:var(--muted); margin-bottom:16px; line-height:1.55; \}\
\
    /* \uc0\u9472 \u9472  WELCOME \u9472 \u9472  */\
    .welcome \{ text-align:center; padding:48px 20px 32px; max-width:480px; margin:0 auto; \}\
    .w-emoji \{ font-size:5rem; margin-bottom:18px; \}\
    .welcome h2 \{ font-size:1.75rem; font-weight:800; margin-bottom:10px; \}\
    .welcome p  \{ color:var(--muted); line-height:1.7; font-size:.93rem; margin-bottom:26px; \}\
    .feat-list \{ text-align:left; background:#fff; border-radius:16px;\
      padding:16px; margin-bottom:26px; box-shadow:0 1px 6px rgba(0,0,0,.06); \}\
    .feat \{ display:flex; align-items:center; gap:11px;\
      padding:7px 0; border-bottom:1px solid var(--bg); font-size:.87rem; \}\
    .feat:last-child \{ border-bottom:none; \}\
    .fi \{ font-size:1.2rem; flex-shrink:0; \}\
\
    /* \uc0\u9472 \u9472  TOAST \u9472 \u9472  */\
    #toast \{ position:fixed; bottom:92px; left:50%;\
      transform:translateX(-50%) translateY(14px);\
      background:rgba(45,55,72,.95); color:#fff;\
      padding:9px 20px; border-radius:22px; font-size:.85rem;\
      font-weight:500; opacity:0; transition:all .25s; z-index:999;\
      white-space:nowrap; pointer-events:none; \}\
    #toast.show \{ opacity:1; transform:translateX(-50%) translateY(0); \}\
\
    .foot-row \{ display:flex; justify-content:center; gap:4px; flex-wrap:wrap; padding:4px 0; \}\
  </style>\
</head>\
<body>\
\
<div id="toast"></div>\
<button id="fab" onclick="openModal('m-action')">+</button>\
\
<!-- \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
     SCREEN 1 \'97 WELCOME\
\uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552  -->\
<div class="screen active" id="s-welcome">\
  <div class="welcome">\
    <div class="w-emoji">\uc0\u55356 \u57235 </div>\
    <h2>Campus Cash</h2>\
    <p>Smart money management for college.<br>\
       Track allowance, dining points, earnings & savings.</p>\
    <div class="feat-list">\
      <div class="feat"><span class="fi">\uc0\u55357 \u56501 </span>Set monthly allowance + dining meal plan</div>\
      <div class="feat"><span class="fi">\uc0\u55357 \u56522 </span>Allocate % of budget per category (5% steps)</div>\
      <div class="feat"><span class="fi">\uc0\u55356 \u57213 \u65039 </span>Dining points tracked separately from cash</div>\
      <div class="feat"><span class="fi">\uc0\u55357 \u56520 </span>Log earnings \'97 all adds to total assets</div>\
      <div class="feat"><span class="fi">\uc0\u55357 \u56496 </span>Total assets = savings + earnings + remaining</div>\
      <div class="feat"><span class="fi">\uc0\u55357 \u56580 </span>Monthly reset saves unspent amounts</div>\
    </div>\
    <button class="btn btn-primary" onclick="startSetup()">Get Started \uc0\u8594 </button>\
  </div>\
</div>\
\
<!-- \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
     SCREEN 2 \'97 SETUP (Allowance + Dining)\
\uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552  -->\
<div class="screen" id="s-setup">\
  <div class="header">\
    <div class="hd-inner">\
      <div><div class="hd-title">\uc0\u55357 \u56496  Campus Cash</div><div class="hd-sub">Step 1 of 2</div></div>\
    </div>\
  </div>\
  <div class="content">\
    <div class="steps">\
      <div class="step active" id="s-dot1"></div>\
      <div class="step"        id="s-dot2"></div>\
    </div>\
    <div class="card">\
\
      <!-- \uc0\u9472 \u9472  SAME AS LAST MONTH \u9472 \u9472  -->\
      <div id="same-setup-wrap" style="display:none;">\
        <button class="same-btn" onclick="useSameSetup()">\
          <span>\uc0\u9989  Same amounts as last month</span>\
          <span class="sb-val" id="same-setup-lbl">\'97</span>\
        </button>\
        <div class="or-row">or enter different amounts below</div>\
      </div>\
\
      <!-- \uc0\u9472 \u9472  ALLOWANCE \u9472 \u9472  -->\
      <div class="sec-hd">\uc0\u55357 \u56501  Monthly Allowance</div>\
      <p>How much money do you have for this month?</p>\
      <div class="field money">\
        <label>Monthly Allowance</label>\
        <input type="number" id="inp-allowance" placeholder="0.00" min="1" step="0.01"/>\
      </div>\
\
      <div class="divider"></div>\
\
      <!-- \uc0\u9472 \u9472  DINING POINTS \u9472 \u9472  -->\
      <div class="sec-hd">\uc0\u55356 \u57213 \u65039  Dining Points (Meal Plan)</div>\
      <p>Your campus meal plan balance for this month.\
         Tracked separately \'97 overflow goes to your Food &amp; Dining budget.</p>\
      <div class="field pts">\
        <label>Dining Points Balance</label>\
        <input type="number" id="inp-dining" placeholder="0" min="0" step="0.01"/>\
      </div>\
\
      <button class="btn btn-primary" onclick="submitSetup()">Next: Set Category Splits \uc0\u8594 </button>\
    </div>\
  </div>\
</div>\
\
<!-- \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
     SCREEN 3 \'97 ALLOCATION\
\uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552  -->\
<div class="screen" id="s-alloc">\
  <div class="header">\
    <div class="hd-inner">\
      <div><div class="hd-title">\uc0\u55357 \u56496  Campus Cash</div><div class="hd-sub">Step 2 of 2 \'97 Divide Budget</div></div>\
    </div>\
  </div>\
  <div class="content">\
    <div class="steps">\
      <div class="step done"></div>\
      <div class="step active"></div>\
    </div>\
    <div class="card">\
      <h2>Category Percentages</h2>\
      <p>Enter what <strong>% of <span id="lbl-allowance">$0</span>/month</strong> goes to\
         each category. Dollar amounts are auto-calculated.</p>\
\
      <!-- \uc0\u9472 \u9472  SAME ALLOCATIONS \u9472 \u9472  -->\
      <div id="same-alloc-wrap" style="display:none;">\
        <button class="same-btn" onclick="useSameAllocations()">\
          <span>\uc0\u9989  Same category splits as last month</span>\
          <span class="sb-val" id="same-alloc-lbl">Same %</span>\
        </button>\
        <div class="or-row">or adjust percentages below</div>\
      </div>\
\
      <!-- \uc0\u9472 \u9472  ALLOC METER \u9472 \u9472  -->\
      <div class="alloc-box">\
        <div class="alloc-top">\
          <div>\
            <div class="alloc-pct-num" id="alloc-pct-num">0%</div>\
            <div class="alloc-pct-lbl">of 100% allocated</div>\
          </div>\
          <div class="alloc-r">\
            <div class="alloc-dlr" id="alloc-dlr">$0.00</div>\
            <div class="alloc-dlr-sub">of <span id="alloc-total">$0</span></div>\
          </div>\
        </div>\
        <div class="pbar pb10">\
          <div class="pbar-fill" id="alloc-fill" style="width:0%"></div>\
        </div>\
        <div class="alloc-foot">\
          <span id="alloc-remain" style="font-weight:500;"></span>\
          <span style="color:var(--faint);font-size:.71rem;">100% = <span id="alloc-full">$0</span></span>\
        </div>\
      </div>\
\
      <div class="hint">\
        \uc0\u55357 \u56481  Use <strong>\u8722 /+</strong> for 5% steps, or type any number manually\
      </div>\
\
      <div class="add-row">\
        <input type="text" id="inp-newcat" placeholder="Add custom category\'85" maxlength="22"/>\
        <button onclick="addCustomCat()">+</button>\
      </div>\
\
      <div class="sc-scroll" id="setup-list"></div>\
      <div id="setup-err"></div>\
\
      <button class="btn btn-primary" style="margin-top:12px;" onclick="finishSetup()">\
        Start Tracking \uc0\u55357 \u56960 \
      </button>\
      <button class="btn btn-ghost" onclick="navTo('s-setup')">\uc0\u8592  Back</button>\
    </div>\
  </div>\
</div>\
\
<!-- \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
     SCREEN 4 \'97 DASHBOARD\
\uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552  -->\
<div class="screen" id="s-dashboard">\
  <div class="header">\
    <div class="hd-inner">\
      <div>\
        <div class="hd-title">\uc0\u55357 \u56496  Campus Cash</div>\
        <div class="hd-sub" id="month-lbl">\'97</div>\
      </div>\
      <button class="hd-btn" onclick="openReconfigure()">\uc0\u9881 \u65039  Edit</button>\
    </div>\
  </div>\
  <div class="content">\
\
    <!-- Hero -->\
    <div class="hero" id="hero-card">\
      <div class="hero-lbl">Total Remaining This Month</div>\
      <div class="hero-amt" id="hero-rem">$0.00</div>\
      <div class="hero-grid">\
        <div class="hero-item">\
          <div class="hi-lbl">Monthly Budget</div>\
          <div class="hi-val" id="h-budget">$0</div>\
        </div>\
        <div class="hero-item">\
          <div class="hi-lbl">Allowance Spent</div>\
          <div class="hi-val" id="h-spent">$0</div>\
        </div>\
        <div class="hero-item">\
          <div class="hi-lbl">Transactions</div>\
          <div class="hi-val" id="h-txns">0</div>\
        </div>\
        <div class="hero-item">\
          <div class="hi-lbl">Today</div>\
          <div class="hi-val" id="h-day">\'97</div>\
        </div>\
      </div>\
      <div id="hero-ovr-wrap"></div>\
    </div>\
\
    <!-- Mini cards: Total Assets + Dining -->\
    <div class="mini-row">\
      <div class="a-card">\
        <div class="ac-lbl">\uc0\u55357 \u56496  Total Assets</div>\
        <div class="ac-amt" id="ac-total">$0.00</div>\
        <div class="ac-rows" id="ac-breakdown"></div>\
        <button class="ac-addbtn" onclick="openModal('m-earning')">+ Add Earning</button>\
      </div>\
      <div class="d-card ok" id="d-card">\
        <div class="dc-lbl">\uc0\u55356 \u57213 \u65039  Dining Points</div>\
        <div class="dc-amt" id="dc-amt">0 pts</div>\
        <div class="dc-sub" id="dc-sub">this month</div>\
        <div class="dc-bar-wrap">\
          <div class="dc-bar">\
            <div class="dc-bar-fill" id="dc-bar-fill" style="width:100%"></div>\
          </div>\
          <div class="dc-pct" id="dc-pct">100% remaining</div>\
        </div>\
      </div>\
    </div>\
\
    <!-- Tabs -->\
    <div class="nav-tabs">\
      <button class="ntab active" onclick="switchTab(this,'tab-budget')">\uc0\u55357 \u56522  Budget</button>\
      <button class="ntab"        onclick="switchTab(this,'tab-history')">\uc0\u55357 \u56523  History</button>\
    </div>\
\
    <!-- Budget Tab -->\
    <div id="tab-budget">\
      <div class="sec-title">\
        <span>Categories</span>\
        <span id="cat-status"></span>\
      </div>\
      <div id="dining-cat-card"></div>\
      <div id="cat-cards"></div>\
    </div>\
\
    <!-- History Tab -->\
    <div id="tab-history" style="display:none;">\
      <div class="sec-title">\
        <span>All Activity</span>\
        <button class="btn-del btn-sm" id="btn-clearall"\
          style="display:none;color:var(--danger);"\
          onclick="clearAllActivity()">Clear All</button>\
      </div>\
      <div class="card" style="padding:4px 16px;">\
        <div id="txn-list"></div>\
      </div>\
    </div>\
\
    <div class="foot-row">\
      <button class="btn-text" onclick="showNewMonthSummary()">\uc0\u55357 \u56580  New Month</button>\
      <button class="btn-text" onclick="confirmDo('\uc0\u9888 \u65039  Reset App?',\
        'All data will be permanently deleted.',resetApp)">\uc0\u55357 \u56785 \u65039  Reset App</button>\
    </div>\
  </div>\
</div>\
\
<!-- \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
     MODAL \'97 ACTION PICKER\
\uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552  -->\
<div class="modal-bg" id="m-action" onclick="bgClose(event,'m-action')">\
  <div class="modal-box">\
    <div class="modal-handle"></div>\
    <h2>What would you like to add?</h2>\
    <div class="action-list">\
      <button class="action-item" onclick="closeModal('m-action');openExpModal('allowance')">\
        <div class="ai-ico" style="background:#EDE9FF;">\uc0\u55357 \u56496 </div>\
        <div><div>Regular Expense</div>\
          <div class="ai-sub">Deducted from your allowance categories</div></div>\
      </button>\
      <button class="action-item" onclick="closeModal('m-action');openExpModal('dining')">\
        <div class="ai-ico" style="background:#FFE8E0;">\uc0\u55356 \u57213 \u65039 </div>\
        <div><div>On-Campus Dining</div>\
          <div class="ai-sub">Uses dining points first; overflow \uc0\u8594  Food budget</div></div>\
      </button>\
      <button class="action-item" onclick="closeModal('m-action');openModal('m-earning')">\
        <div class="ai-ico" style="background:#EDFAF3;">\uc0\u55357 \u56520 </div>\
        <div><div>Add Earning</div>\
          <div class="ai-sub">Adds to total assets &amp; counts as savings at month end</div></div>\
      </button>\
    </div>\
  </div>\
</div>\
\
<!-- \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
     MODAL \'97 ADD EXPENSE (Allowance / Dining toggle)\
\uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552  -->\
<div class="modal-bg" id="m-expense" onclick="bgClose(event,'m-expense')">\
  <div class="modal-box">\
    <div class="modal-handle"></div>\
    <!-- Toggle -->\
    <div class="exp-toggle">\
      <button class="et-btn active" id="et-allow" onclick="setExpType('allowance')">\uc0\u55357 \u56496  Allowance</button>\
      <button class="et-btn"        id="et-dining" onclick="setExpType('dining')">\uc0\u55356 \u57213 \u65039  Dining</button>\
    </div>\
\
    <!-- ALLOWANCE SECTION -->\
    <div id="exp-allow-sec">\
      <h2>\uc0\u10133  Regular Expense</h2>\
      <div class="field">\
        <label>Description</label>\
        <input type="text" id="exp-desc" placeholder="e.g., Textbooks, Bus fare\'85" maxlength="40"/>\
      </div>\
      <div class="field money">\
        <label>Amount</label>\
        <input type="number" id="exp-amt" placeholder="0.00" min="0.01" step="0.01"\
               oninput="refreshCatInfo()"/>\
      </div>\
      <div class="field">\
        <label>Category</label>\
        <select id="exp-cat" onchange="refreshCatInfo()">\
          <option value="">\'97 Select a category \'97</option>\
        </select>\
      </div>\
      <div id="cat-info"></div>\
      <div id="exp-err"></div>\
      <button class="btn btn-primary" onclick="submitExpense()">Add Expense \uc0\u55357 \u56504 </button>\
    </div>\
\
    <!-- DINING SECTION -->\
    <div id="exp-dining-sec" style="display:none;">\
      <h2>\uc0\u55356 \u57213 \u65039  On-Campus Dining</h2>\
      <div class="field">\
        <label>Description</label>\
        <input type="text" id="din-desc" placeholder="e.g., Campus Cafe, Dining Hall\'85" maxlength="40"/>\
      </div>\
      <div class="field money">\
        <label>Amount</label>\
        <input type="number" id="din-amt" placeholder="0.00" min="0.01" step="0.01"\
               oninput="refreshDiningInfo()"/>\
      </div>\
      <div id="din-info"></div>\
      <div id="din-err"></div>\
      <button class="btn btn-primary" onclick="submitDiningExpense()"\
        style="background:linear-gradient(135deg,#e17055,#c0392b);\
               box-shadow:0 4px 14px rgba(192,57,43,.3);">\
        Add Dining Expense \uc0\u55356 \u57213 \u65039 \
      </button>\
    </div>\
  </div>\
</div>\
\
<!-- \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
     MODAL \'97 ADD EARNING\
\uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552  -->\
<div class="modal-bg" id="m-earning" onclick="bgClose(event,'m-earning')">\
  <div class="modal-box">\
    <div class="modal-handle"></div>\
    <h2>\uc0\u55357 \u56520  Add Earning</h2>\
    <p style="color:var(--muted);font-size:.84rem;margin-bottom:14px;">\
      Earnings boost your total assets immediately and are saved at month end.\
    </p>\
    <div class="field">\
      <label>Source / Description</label>\
      <input type="text" id="earn-desc" placeholder="e.g., Part-time job, Gift\'85" maxlength="40"/>\
    </div>\
    <div class="field money">\
      <label>Amount</label>\
      <input type="number" id="earn-amt" placeholder="0.00" min="0.01" step="0.01"/>\
    </div>\
    <div id="earn-err"></div>\
    <button class="btn btn-primary" onclick="submitEarning()"\
      style="background:linear-gradient(135deg,#00B894,#00896F);\
             box-shadow:0 4px 14px rgba(0,184,148,.3);">\
      Add Earning \uc0\u55357 \u56501 \
    </button>\
  </div>\
</div>\
\
<!-- \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
