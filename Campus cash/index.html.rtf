<script>\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
// STATE\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
let S = \{\
  allowance:          0,\
  diningPoints:       0,\
  monthStart:         '',\
  categories:         [],\
  transactions:       [],        // \{id,categoryId,amount,description,date,isDiningOverflow,linkedDiningId\}\
  diningTransactions: [],        // \{id,description,totalAmount,diningPointsUsed,overflowAmount,overflowTxnId,date\}\
  earnings:           [],        // \{id,amount,description,date\}\
  savedFromPrevMonths:0,\
  lastAllowance:      0,\
  lastDiningPoints:   0,\
  lastCategories:     [],\
\};\
\
let setupCats  = [];\
let pendingCb  = null;\
const KEY      = 'campusCash_v6';\
\
const DEFAULTS = [\
  \{ name:'Food & Dining',   icon:'\uc0\u55356 \u57172 ', color:'#FF6B6B' \},\
  \{ name:'Transport',       icon:'\uc0\u55357 \u56972 ', color:'#4ECDC4' \},\
  \{ name:'School Supplies', icon:'\uc0\u55357 \u56538 ', color:'#45B7D1' \},\
  \{ name:'Entertainment',   icon:'\uc0\u55356 \u57262 ', color:'#A29BFE' \},\
  \{ name:'Personal Care',   icon:'\uc0\u55358 \u56820 ', color:'#FDCB6E' \},\
  \{ name:'Savings',         icon:'\uc0\u55357 \u56462 ', color:'#00B894' \},\
];\
const ICONS  = ['\uc0\u55357 \u57042 ','\u55356 \u57291 \u65039 ','\u55357 \u56458 ','\u55357 \u56561 ','\u55356 \u57269 ','\u9749 ','\u55356 \u57256 ','\u9992 \u65039 ','\u55356 \u57312 ','\u55357 \u56550 ','\u55356 \u57173 ','\u55356 \u57263 '];\
const COLORS = ['#FF8C94','#C3B1E1','#B5EAD7','#FFDAC1','#E2C2FF','#A8E6CF',\
                '#FFD3B6','#C7CEEA','#F6E6CB','#D4F1F4','#FFB3BA','#E0FBFC'];\
\
let _idCounter = Date.now();\
function genId(pfx) \{ return `$\{pfx\}$\{++_idCounter\}`; \}\
\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
// STORAGE\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
function save() \{ localStorage.setItem(KEY, JSON.stringify(S)); \}\
function load() \{\
  const r = localStorage.getItem(KEY);\
  if (r) S = \{ ...S, ...JSON.parse(r) \};\
\}\
\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
// INIT\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
function init() \{\
  load();\
  if (S.allowance > 0 && S.categories.length > 0) \{\
    navTo('s-dashboard'); renderDashboard(); showFab(true);\
  \} else \{\
    navTo('s-welcome');\
  \}\
\}\
\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
// NAVIGATION\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
function navTo(id) \{\
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));\
  document.getElementById(id).classList.add('active');\
  window.scrollTo(0, 0);\
\}\
function showFab(v) \{\
  document.getElementById('fab').style.display = v ? 'flex' : 'none';\
\}\
\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
// COMPUTED VALUES\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
function totalAllowanceSpent()   \{ return S.transactions.reduce((s,t)=>s+t.amount,0); \}\
function diningPointsUsed()      \{ return S.diningTransactions.reduce((s,t)=>s+t.diningPointsUsed,0); \}\
function diningPointsRemaining() \{ return S.diningPoints - diningPointsUsed(); \}\
function totalEarnings()         \{ return S.earnings.reduce((s,e)=>s+e.amount,0); \}\
function remainingAllowance()    \{ return S.allowance - totalAllowanceSpent(); \}\
function totalAssets()           \{ return S.savedFromPrevMonths + totalEarnings() + remainingAllowance(); \}\
function catSpent(id)            \{ return S.transactions.filter(t=>t.categoryId===id).reduce((s,t)=>s+t.amount,0); \}\
function totalCategoryOverflow() \{\
  return S.categories.reduce((s,c)=>\{\
    const o = catSpent(c.id) - c.budget;\
    return s + (o>0 ? o : 0);\
  \}, 0);\
\}\
function findFoodCategory() \{\
  return S.categories.find(c =>\
    c.name.toLowerCase().includes('food') ||\
    c.name.toLowerCase().includes('dining') ||\
    c.name.toLowerCase().includes('meal')\
  ) || S.categories[0];\
\}\
\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
// SETUP \'97 STEP 1: ALLOWANCE + DINING\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
function startSetup() \{\
  prepSetupScreen();\
  navTo('s-setup');\
\}\
\
function prepSetupScreen() \{\
  if (S.lastAllowance > 0) \{\
    document.getElementById('same-setup-wrap').style.display = 'block';\
    document.getElementById('same-setup-lbl').textContent =\
      `$$\{S.lastAllowance.toFixed(2)\} / $\{S.lastDiningPoints.toFixed(0)\} pts`;\
  \} else \{\
    document.getElementById('same-setup-wrap').style.display = 'none';\
  \}\
\}\
\
function useSameSetup() \{\
  document.getElementById('inp-allowance').value = S.lastAllowance;\
  document.getElementById('inp-dining').value    = S.lastDiningPoints;\
  toast('\uc0\u9989  Filled with last month\\'s amounts');\
\}\
\
function submitSetup() \{\
  const a = parseFloat(document.getElementById('inp-allowance').value);\
  const d = parseFloat(document.getElementById('inp-dining').value) || 0;\
  if (!a || a < 0.01) \{ toast('\uc0\u9888 \u65039  Enter a valid allowance amount'); return; \}\
  S.allowance    = a;\
  S.diningPoints = d;\
\
  // Update alloc screen labels\
  document.getElementById('lbl-allowance').textContent = `$$\{a.toFixed(2)\}`;\
  document.getElementById('alloc-total').textContent   = `$$\{a.toFixed(2)\}`;\
  document.getElementById('alloc-full').textContent    = `$$\{a.toFixed(2)\}`;\
\
  // Show "same as last" for allocations\
  if (S.lastCategories.length > 0) \{\
    document.getElementById('same-alloc-wrap').style.display = 'block';\
    document.getElementById('same-alloc-lbl').textContent =\
      `$\{S.lastCategories.filter(c=>c.percentage>0).length\} categories`;\
  \} else \{\
    document.getElementById('same-alloc-wrap').style.display = 'none';\
  \}\
\
  initSetupCats();\
  document.getElementById('s-dot1').className = 'step done';\
  document.getElementById('s-dot2').className = 'step active';\
  navTo('s-alloc');\
\}\
\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
// SETUP \'97 STEP 2: ALLOCATIONS\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
function initSetupCats(prefill) \{\
  if (prefill) \{\
    setupCats = prefill.map(c => (\{\
      ...c,\
      percentage: c.percentage || 0,\
      budget: parseFloat(((c.percentage||0)/100*S.allowance).toFixed(2))\
    \}));\
  \} else \{\
    setupCats = DEFAULTS.map((d,i) => (\{\
      id: genId('cat'), name:d.name, icon:d.icon, color:d.color, percentage:0, budget:0\
    \}));\
  \}\
  renderSetupCats();\
\}\
\
function useSameAllocations() \{\
  initSetupCats(S.lastCategories);\
  toast('\uc0\u9989  Loaded last month\\'s category splits');\
\}\
\
function renderSetupCats() \{\
  const el = document.getElementById('setup-list');\
  el.innerHTML = '';\
  setupCats.forEach(c => \{\
    const pct = c.percentage || 0;\
    const amt = (pct / 100 * S.allowance).toFixed(2);\
    const row = document.createElement('div');\
    row.className = 'sc-row';\
    row.id = `sc-$\{c.id\}`;\
    row.innerHTML = `\
      <span class="sc-ico">$\{c.icon\}</span>\
      <span class="sc-nm" title="$\{c.name\}">$\{c.name\}</span>\
      <div class="stepper">\
        <button class="sp-btn minus" onclick="stepPct('$\{c.id\}',-5)">\uc0\u8722 </button>\
        <input  class="sp-inp" type="number" id="sci-$\{c.id\}"\
                placeholder="0" min="0" max="100"\
                value="$\{pct > 0 ? pct : ''\}"\
                oninput="onPctChange('$\{c.id\}',this.value)"/>\
        <button class="sp-btn plus"  onclick="stepPct('$\{c.id\}',5)">+</button>\
        <span class="sp-sym">%</span>\
      </div>\
      <span class="sc-arrow">\uc0\u8594 </span>\
      <span class="sc-calc$\{pct===0?' zero':''\}" id="scv-$\{c.id\}">$$\{amt\}</span>\
      <button class="btn-del" onclick="removeSetupCat('$\{c.id\}')">\uc0\u10005 </button>\
    `;\
    el.appendChild(row);\
  \});\
  updateAllocBar();\
\}\
\
function stepPct(id, delta) \{\
  const inp = document.getElementById(`sci-$\{id\}`);\
  const cur = parseFloat(inp.value) || 0;\
  const nv  = Math.max(0, Math.min(100, cur + delta));\
  inp.value = nv;\
  onPctChange(id, nv);\
\}\
\
function onPctChange(id, val) \{\
  const c = setupCats.find(x => String(x.id) === String(id));\
  if (!c) return;\
  c.percentage = Math.max(0, Math.min(100, parseFloat(val) || 0));\
  c.budget     = parseFloat((c.percentage / 100 * S.allowance).toFixed(2));\
  const el = document.getElementById(`scv-$\{c.id\}`);\
  if (el) \{\
    el.textContent = `$$\{c.budget.toFixed(2)\}`;\
    el.className   = `sc-calc$\{c.percentage === 0 ? ' zero' : ''\}`;\
  \}\
  updateAllocBar();\
\}\
\
function addCustomCat() \{\
  const inp  = document.getElementById('inp-newcat');\
  const name = inp.value.trim();\
  if (!name) \{ toast('Type a category name first'); return; \}\
  if (setupCats.find(c => c.name.toLowerCase() === name.toLowerCase())) \{\
    toast('Category already exists'); return;\
  \}\
  const idx = setupCats.length % ICONS.length;\
  setupCats.push(\{ id:genId('cat'), name, icon:ICONS[idx], color:COLORS[idx],\
                   percentage:0, budget:0 \});\
  inp.value = '';\
  renderSetupCats();\
  const list = document.getElementById('setup-list');\
  list.scrollTop = list.scrollHeight;\
  toast(`"$\{name\}" added`);\
\}\
\
function removeSetupCat(id) \{\
  setupCats = setupCats.filter(c => String(c.id) !== String(id));\
  renderSetupCats();\
\}\
\
function updateAllocBar() \{\
  const totalPct = setupCats.reduce((s,c) => s + (c.percentage||0), 0);\
  const remPct   = 100 - totalPct;\
  const allocAmt = totalPct / 100 * S.allowance;\
  const fill     = document.getElementById('alloc-fill');\
  const pctEl    = document.getElementById('alloc-pct-num');\
  const remEl    = document.getElementById('alloc-remain');\
\
  pctEl.textContent = `$\{Math.round(totalPct)\}%`;\
  document.getElementById('alloc-dlr').textContent = `$$\{allocAmt.toFixed(2)\}`;\
  fill.style.width = `$\{Math.min(totalPct, 100)\}%`;\
\
  if (totalPct > 100.05) \{\
    remEl.textContent = `\uc0\u9888 \u65039  Over by $\{(totalPct-100).toFixed(1)\}% \'97 please reduce`;\
    remEl.style.color = 'var(--danger)';\
    fill.style.background = 'var(--danger)';\
    pctEl.style.color = 'var(--danger)';\
  \} else if (remPct < 0.05) \{\
    remEl.textContent = '\uc0\u9989  100% fully allocated!';\
    remEl.style.color = 'var(--success)';\
    fill.style.background = 'var(--success)';\
    pctEl.style.color = 'var(--success)';\
  \} else \{\
    remEl.textContent = `$\{remPct.toFixed(1)\}% ($$\{(remPct/100*S.allowance).toFixed(2)\}) \uc0\u8594  "Other"`;\
    remEl.style.color = 'var(--muted)';\
    fill.style.background = 'linear-gradient(90deg,var(--success),var(--primary))';\
    pctEl.style.color = 'var(--primary)';\
  \}\
\}\
\
function finishSetup() \{\
  const errEl    = document.getElementById('setup-err');\
  const totalPct = setupCats.reduce((s,c) => s + (c.percentage||0), 0);\
  if (totalPct > 100.05) \{\
    errEl.innerHTML = `<div class="alert a-err">\uc0\u9888 \u65039  Over by $\{(totalPct-100).toFixed(1)\}%. Reduce some percentages.</div>`;\
    return;\
  \}\
  const active = setupCats.filter(c => c.percentage > 0.001);\
  if (!active.length) \{\
    errEl.innerHTML = `<div class="alert a-err">\uc0\u9888 \u65039  Set a percentage for at least one category.</div>`;\
    return;\
  \}\
  errEl.innerHTML = '';\
\
  let final = active.map(c => (\{\
    ...c, budget: parseFloat((c.percentage/100*S.allowance).toFixed(2))\
  \}));\
  const remPct = 100 - totalPct;\
  if (remPct > 0.05) \{\
    final.push(\{ id:genId('cat'), name:'Other', icon:'\uc0\u55357 \u56550 ', color:'#BDC3C7',\
      percentage: parseFloat(remPct.toFixed(2)),\
      budget: parseFloat((remPct/100*S.allowance).toFixed(2)) \});\
  \}\
\
  S.categories = final;\
  S.monthStart = new Date().toISOString().split('T')[0];\
  // Only clear transactions if it's a fresh setup (not edit)\
  if (!S.transactions.length && !S.diningTransactions.length) \{\
    S.earnings = S.earnings || [];\
  \}\
  save();\
  navTo('s-dashboard'); showFab(true); renderDashboard();\
  toast('\uc0\u55356 \u57225  Budget ready! Tap + to log expenses.');\
\}\
\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
// DASHBOARD RENDER\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
function renderDashboard() \{\
  renderHero();\
  renderAssetCard();\
  renderDiningMiniCard();\
  renderDiningCatCard();\
  renderCatCards();\
  renderTxnList();\
  updateMonthLabel();\
\}\
\
function updateMonthLabel() \{\
  const el = document.getElementById('month-lbl');\
  if (!S.monthStart) return;\
  const d = new Date(S.monthStart + 'T00:00:00');\
  el.textContent = d.toLocaleDateString('en-US',\{month:'long',year:'numeric'\});\
\}\
\
function renderHero() \{\
  const remAllow = remainingAllowance();\
  const spent    = totalAllowanceSpent();\
  const pct      = S.allowance > 0 ? remAllow / S.allowance * 100 : 100;\
  const overflow = totalCategoryOverflow();\
\
  document.getElementById('hero-rem').textContent = `$$\{remAllow.toFixed(2)\}`;\
  document.getElementById('h-budget').textContent = `$$\{S.allowance.toFixed(2)\}`;\
  document.getElementById('h-spent').textContent  = `$$\{spent.toFixed(2)\}`;\
  document.getElementById('h-txns').textContent   =\
    S.transactions.length + S.diningTransactions.length + S.earnings.length;\
  document.getElementById('h-day').textContent    =\
    new Date().toLocaleDateString('en-US',\{month:'short',day:'numeric'\});\
\
  const hero = document.getElementById('hero-card');\
  if      (pct < 0)  hero.style.background = 'linear-gradient(135deg,#2D3436,#1a1a2e)';\
  else if (pct < 15) hero.style.background = 'linear-gradient(135deg,#FF4757,#C0392B)';\
  else if (pct < 30) hero.style.background = 'linear-gradient(135deg,#FFA502,#E67E22)';\
  else               hero.style.background = 'linear-gradient(135deg,var(--primary),var(--pdark))';\
\
  const ovrWrap = document.getElementById('hero-ovr-wrap');\
  if (overflow > 0.005) \{\
    ovrWrap.innerHTML = `<div class="hero-ovr">\
      \uc0\u9888 \u65039  $$\{overflow.toFixed(2)\} over category budgets \'97 deducted from total assets\
    </div>`;\
  \} else \{\
    ovrWrap.innerHTML = '';\
  \}\
\}\
\
function renderAssetCard() \{\
  const assets   = totalAssets();\
  const saved    = S.savedFromPrevMonths;\
  const earned   = totalEarnings();\
  const remAllow = remainingAllowance();\
\
  document.getElementById('ac-total').textContent = `$$\{assets.toFixed(2)\}`;\
  document.getElementById('ac-breakdown').innerHTML = `\
    <div class="ac-row">\
      <span>Prev. savings</span><span>$$\{saved.toFixed(2)\}</span>\
    </div>\
    <div class="ac-row">\
      <span>This mo. earnings</span><span>$$\{earned.toFixed(2)\}</span>\
    </div>\
    <div class="ac-row">\
      <span>Allowance left</span>\
      <span class="$\{remAllow<0?'ac-neg':''\}">$$\{remAllow.toFixed(2)\}</span>\
    </div>\
  `;\
\}\
\
function renderDiningMiniCard() \{\
  const rem  = diningPointsRemaining();\
  const pct  = S.diningPoints > 0 ? Math.max(rem/S.diningPoints*100, 0) : 0;\
  const card = document.getElementById('d-card');\
\
  document.getElementById('dc-amt').textContent = `$\{rem.toFixed(2)\} pts`;\
  document.getElementById('dc-pct').textContent = `$\{Math.round(pct)\}% remaining`;\
  document.getElementById('dc-bar-fill').style.width = `$\{Math.max(pct,0)\}%`;\
\
  if (rem <= 0) \{\
    document.getElementById('dc-sub').textContent = '\uc0\u9888 \u65039  Points depleted!';\
    card.className = 'd-card empty';\
  \} else \{\
    document.getElementById('dc-sub').textContent = `of $\{S.diningPoints.toFixed(2)\} pts`;\
    card.className = 'd-card ok';\
  \}\
\}\
\
function renderDiningCatCard() \{\
  const wrap         = document.getElementById('dining-cat-card');\
  const dpUsed       = diningPointsUsed();\
  const dpRem        = diningPointsRemaining();\
  const pct          = S.diningPoints>0 ? Math.min(dpUsed/S.diningPoints*100,100) : 0;\
  const overflowTotal= S.diningTransactions.reduce((s,t)=>s+(t.overflowAmount||0),0);\
  const foodCat      = findFoodCategory();\
\
  const overflowNote = overflowTotal > 0.005\
    ? `<div style="font-size:.7rem;color:#c0392b;margin-top:4px;">\
         \uc0\u9888 \u65039  $$\{overflowTotal.toFixed(2)\} overflow charged \u8594  $\{foodCat?.name||'Food'\} budget\
       </div>`\
    : '';\
\
  wrap.innerHTML = `\
    <div class="cat-card" style="border-left-color:#e17055;">\
      <div class="cc-top">\
        <div class="cc-left">\
          <span class="cc-ico">\uc0\u55356 \u57213 \u65039 </span>\
          <div class="cc-info">\
            <div class="cc-name">\
              On-Campus Dining\
              <span class="cc-pct" style="background:#FFE8E0;color:#c0392b;">Meal Plan</span>\
              $\{dpRem<=0?'<span class="badge b-danger">Depleted!</span>':''\}\
            </div>\
            <div class="cc-alloc">$\{S.diningPoints.toFixed(2)\} pts total this month</div>\
            $\{overflowNote\}\
          </div>\
        </div>\
        <div class="cc-right">\
          <div class="cc-rem" style="color:$\{dpRem<=0?'var(--danger)':'var(--dark)'\}">\
            $\{dpRem.toFixed(2)\} pts left\
          </div>\
          <div class="cc-sub">$\{dpUsed.toFixed(2)\} pts used</div>\
        </div>\
      </div>\
      <div class="pbar pb7" style="margin-top:9px;">\
        <div class="pbar-fill"\
             style="width:$\{pct\}%;background:$\{dpRem<=0?'var(--danger)':'#e17055'\};"></div>\
      </div>\
    </div>\
  `;\
\}\
\
function renderCatCards() \{\
  const wrap    = document.getElementById('cat-cards');\
  const overList= S.categories.filter(c=>catSpent(c.id)>c.budget);\
  wrap.innerHTML = '';\
\
  document.getElementById('cat-status').textContent =\
    overList.length ? `\uc0\u9888 \u65039  $\{overList.length\} over budget` : `$\{S.categories.length+1\} categories`;\
\
  S.categories.forEach(cat => \{\
    const spent = catSpent(cat.id);\
    const rem   = cat.budget - spent;\
    const pct   = cat.budget>0 ? Math.min(spent/cat.budget*100,100) : 0;\
    const over  = spent > cat.budget;\
    const warn  = !over && pct >= 75;\
\
    let barColor = cat.color;\
    if (over) barColor = 'var(--danger)';\
    if (warn) barColor = 'var(--warning)';\
\
    let badge = '';\
    if (over)      badge = `<span class="badge b-danger">Over!</span>`;\
    else if (warn) badge = `<span class="badge b-warn">Low</span>`;\
\
    const card = document.createElement('div');\
    card.className = 'cat-card';\
    card.style.borderColor = cat.color;\
    card.innerHTML = `\
      <div class="cc-top">\
        <div class="cc-left">\
          <span class="cc-ico">$\{cat.icon\}</span>\
          <div class="cc-info">\
            <div class="cc-name">\
              $\{cat.name\}\
              <span class="cc-pct">$\{(cat.percentage||0).toFixed(0)\}%</span>\
              $\{badge\}\
            </div>\
            <div class="cc-alloc">\
              $\{(cat.percentage||0).toFixed(0)\}% of $$\{S.allowance.toFixed(2)\}/mo\
            </div>\
          </div>\
        </div>\
        <div class="cc-right">\
          <div class="cc-rem" style="color:$\{over?'var(--danger)':'var(--dark)'\}">\
            $$\{over?'0.00':rem.toFixed(2)\} left\
          </div>\
          <div class="cc-sub">$$\{spent.toFixed(2)\} of $$\{cat.budget.toFixed(2)\}</div>\
        </div>\
      </div>\
      <div class="pbar pb7" style="margin-top:9px;">\
        <div class="pbar-fill" style="width:$\{pct\}%;background:$\{barColor\};"></div>\
      </div>\
    `;\
    wrap.appendChild(card);\
  \});\
\}\
\
function renderTxnList() \{\
  const wrap    = document.getElementById('txn-list');\
  const clearEl = document.getElementById('btn-clearall');\
  wrap.innerHTML = '';\
\
  // Merge all activity into one sorted list\
  const all = [\
    ...S.transactions.map(t   => (\{...t,   _t:'expense'\})),\
    ...S.diningTransactions.map(t => (\{...t, _t:'dining'\})),\
    ...S.earnings.map(e        => (\{...e,   _t:'earning'\})),\
  ].sort((a,b) => new Date(b.date)-new Date(a.date));\
\
  if (!all.length) \{\
    clearEl.style.display = 'none';\
    wrap.innerHTML = `<div class="empty">\
      <div class="empty-ico">\uc0\u55357 \u56541 </div>\
      <div class="empty-text">No activity yet.<br>Tap <strong>+</strong> to get started!</div>\
    </div>`;\
    return;\
  \}\
\
  clearEl.style.display = 'inline-block';\
\
  all.forEach(item => \{\
    const d    = new Date(item.date);\
    const date = d.toLocaleDateString('en-US',\{month:'short',day:'numeric'\});\
    const time = d.toLocaleTimeString('en-US',\{hour:'numeric',minute:'2-digit'\});\
    const row  = document.createElement('div');\
    row.className = 'txn';\
\
    if (item._t === 'expense') \{\
      const cat = S.categories.find(c=>c.id===item.categoryId);\
      const ovTag = item.isDiningOverflow\
        ? `<span style="font-size:.63rem;background:#FFE8E0;color:#c0392b;\
                        padding:1px 5px;border-radius:4px;margin-left:4px;">\
             dining overflow\
           </span>` : '';\
      row.innerHTML = `\
        <div class="txn-ico" style="background:$\{cat?cat.color+'25':'#f0f4f8'\}">\
          $\{cat?cat.icon:'\uc0\u55357 \u56550 '\}</div>\
        <div class="txn-info">\
          <div class="txn-desc">$\{esc(item.description)\}$\{ovTag\}</div>\
          <div class="txn-meta">$\{cat?cat.name:'Unknown'\} \'b7 $\{date\} $\{time\}</div>\
        </div>\
        <div class="txn-right">\
          <span class="amt-neg">\uc0\u8722 $$\{item.amount.toFixed(2)\}</span>\
          <button class="btn-del" onclick="deleteTxn('$\{item.id\}')">\uc0\u55357 \u56785 \u65039 </button>\
        </div>`;\
\
    \} else if (item._t === 'dining') \{\
      const overTag = item.overflowAmount > 0.005\
        ? ` <span style="font-size:.75rem;color:var(--danger);">\
               +\uc0\u8722 $$\{item.overflowAmount.toFixed(2)\}</span>` : '';\
      row.innerHTML = `\
        <div class="txn-ico" style="background:#FFE8E0;">\uc0\u55356 \u57213 \u65039 </div>\
        <div class="txn-info">\
          <div class="txn-desc">$\{esc(item.description)\}</div>\
          <div class="txn-meta">On-Campus Dining \'b7 $\{date\} $\{time\}</div>\
        </div>\
        <div class="txn-right">\
          <span class="amt-pts">\uc0\u8722 $\{item.diningPointsUsed.toFixed(2)\} pts$\{overTag\}</span>\
          <button class="btn-del" onclick="deleteDiningTxn('$\{item.id\}')">\uc0\u55357 \u56785 \u65039 </button>\
        </div>`;\
\
    \} else if (item._t === 'earning') \{\
      row.innerHTML = `\
        <div class="txn-ico" style="background:#EDFAF3;">\uc0\u55357 \u56520 </div>\
        <div class="txn-info">\
          <div class="txn-desc">$\{esc(item.description)\}</div>\
          <div class="txn-meta">Earning \'b7 $\{date\} $\{time\}</div>\
        </div>\
        <div class="txn-right">\
          <span class="amt-pos">+$$\{item.amount.toFixed(2)\}</span>\
          <button class="btn-del" onclick="deleteEarning('$\{item.id\}')">\uc0\u55357 \u56785 \u65039 </button>\
        </div>`;\
    \}\
\
    wrap.appendChild(row);\
  \});\
\}\
\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
// TABS\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
function switchTab(btn, id) \{\
  document.querySelectorAll('.ntab').forEach(t=>t.classList.remove('active'));\
  btn.classList.add('active');\
  document.getElementById('tab-budget').style.display  = id==='tab-budget'  ? 'block':'none';\
  document.getElementById('tab-history').style.display = id==='tab-history' ? 'block':'none';\
\}\
\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
// EXPENSE MODAL\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
function openExpModal(type) \{\
  // Fill category select\
  const sel = document.getElementById('exp-cat');\
  sel.innerHTML = '<option value="">\'97 Select a category \'97</option>';\
  S.categories.forEach(c => \{\
    const rem = Math.max(c.budget - catSpent(c.id), 0);\
    const opt = document.createElement('option');\
    opt.value = c.id;\
    opt.textContent = `$\{c.icon\} $\{c.name\}  ($$\{rem.toFixed(2)\} left)`;\
    sel.appendChild(opt);\
  \});\
  // Clear fields\
  ['exp-desc','exp-amt','din-desc','din-amt']\
    .forEach(id => document.getElementById(id).value = '');\
  ['cat-info','exp-err','din-info','din-err']\
    .forEach(id => document.getElementById(id).innerHTML = '');\
  setExpType(type);\
  openModal('m-expense');\
  setTimeout(() => \{\
    const f = type==='dining'?'din-desc':'exp-desc';\
    document.getElementById(f).focus();\
  \}, 320);\
\}\
\
function setExpType(type) \{\
  const allow = type === 'allowance';\
  document.getElementById('et-allow').classList.toggle('active', allow);\
  document.getElementById('et-dining').classList.toggle('active', !allow);\
  document.getElementById('exp-allow-sec').style.display  = allow  ? 'block' : 'none';\
  document.getElementById('exp-dining-sec').style.display = !allow ? 'block' : 'none';\
  if (!allow) refreshDiningInfo();\
\}\
\
function refreshCatInfo() \{\
  const catId = document.getElementById('exp-cat').value; // \uc0\u8592  string, no parseInt\
  const amt   = parseFloat(document.getElementById('exp-amt').value) || 0;\
  const el    = document.getElementById('cat-info');\
\
  if (!catId) \{ el.innerHTML = ''; return; \}\
\
  const cat = S.categories.find(c => String(c.id) === String(catId));\
  if (!cat)  \{ el.innerHTML = ''; return; \}\
\
  const rem = cat.budget - catSpent(cat.id);\
  let cls = 'a-ok';\
  let msg = `\uc0\u9989  $$\{rem.toFixed(2)\} remaining in $\{cat.name\}`;\
\
  if (rem <= 0) \{\
    cls = 'a-err';\
    msg = `\uc0\u10060  $\{cat.name\} is already over budget!`;\
  \} else if (amt > rem) \{\
    cls = 'a-err';\
    msg = `\uc0\u9888 \u65039  Over by $$\{(amt - rem).toFixed(2)\} in $\{cat.name\}`;\
  \} else if (amt > 0 && (rem - amt) / cat.budget < 0.2) \{\
    cls = 'a-warn';\
    msg = `\uc0\u9888 \u65039  Only $$\{(rem - amt).toFixed(2)\} will remain in $\{cat.name\}`;\
  \}\
  el.innerHTML = `<div class="alert $\{cls\}">$\{msg\}</div>`;\
\}\
\
function refreshDiningInfo() \{\
  const amt   = parseFloat(document.getElementById('din-amt').value) || 0;\
  const rem   = diningPointsRemaining();\
  const el    = document.getElementById('din-info');\
  const food  = findFoodCategory();\
  const foodRem = food ? Math.max(food.budget - catSpent(food.id), 0) : 0;\
\
  if (!amt) \{\
    el.innerHTML = `<div class="alert a-ok">\uc0\u9989  $\{rem.toFixed(2)\} pts available</div>`;\
    return;\
  \}\
  if (rem >= amt) \{\
    el.innerHTML = `<div class="alert a-ok">\uc0\u9989  $\{amt.toFixed(2)\} pts used ($\{(rem-amt).toFixed(2)\} pts remain)</div>`;\
  \} else if (rem > 0) \{\
    const overflow = amt - rem;\
    const foodWarn = overflow > foodRem ? `<br>\uc0\u9888 \u65039  This will also exceed $\{food?.name||'Food'\} budget!` : '';\
    el.innerHTML = `<div class="alert a-warn">\
      \uc0\u9888 \u65039  Only $\{rem.toFixed(2)\} pts left.<br>\
      $$\{overflow.toFixed(2)\} overflow \uc0\u8594  $\{food?.name||'Food'\} budget$\{foodWarn\}\
    </div>`;\
  \} else \{\
    const foodWarn = amt > foodRem ? `<br>\uc0\u9888 \u65039  This will also exceed $\{food?.name||'Food'\} budget!` : '';\
    el.innerHTML = `<div class="alert a-err">\
      \uc0\u10060  No dining points left!<br>\
      Full $$\{amt.toFixed(2)\} \uc0\u8594  $\{food?.name||'Food'\} budget$\{foodWarn\}\
    </div>`;\
  \}\
\}\
\
function submitExpense() \{\
  const desc  = document.getElementById('exp-desc').value.trim();\
  const amt   = parseFloat(document.getElementById('exp-amt').value);\
  const catId = document.getElementById('exp-cat').value; // \uc0\u8592  string, no parseInt\
  const errEl = document.getElementById('exp-err');\
  errEl.innerHTML = '';\
\
  if (!desc) \{\
    errEl.innerHTML = '<div class="alert a-err">\uc0\u9888 \u65039  Enter a description.</div>';\
    return;\
  \}\
  if (!amt || amt <= 0) \{\
    errEl.innerHTML = '<div class="alert a-err">\uc0\u9888 \u65039  Enter a valid amount.</div>';\
    return;\
  \}\
  if (!catId) \{\
    errEl.innerHTML = '<div class="alert a-err">\uc0\u9888 \u65039  Select a category.</div>';\
    return;\
  \}\
\
  const cat = S.categories.find(c => String(c.id) === String(catId));\
  if (!cat) \{\
    errEl.innerHTML = '<div class="alert a-err">\uc0\u9888 \u65039  Category not found. Try reopening.</div>';\
    return;\
  \}\
\
  const over = amt > (cat.budget - catSpent(cat.id));\
\
  S.transactions.push(\{\
    id:             genId('t'),\
    categoryId:     cat.id,        // \uc0\u8592  store as original string ID\
    amount:         amt,\
    description:    desc,\
    date:           new Date().toISOString(),\
    isDiningOverflow: false\
  \});\
\
  save();\
  renderDashboard();\
  closeModal('m-expense');\
\
  if (over) \{\
    toast(`\uc0\u9888 \u65039  Over budget in $\{cat.name\}! \'97$$\{amt.toFixed(2)\} logged`);\
  \} else \{\
    toast(`\uc0\u55357 \u56504  $$\{amt.toFixed(2)\} \u8594  $\{cat.name\}`);\
  \}\
\}\
\
function submitDiningExpense() \{\
  const desc  = document.getElementById('din-desc').value.trim();\
  const amt   = parseFloat(document.getElementById('din-amt').value);\
  const errEl = document.getElementById('din-err');\
  errEl.innerHTML = '';\
  if (!desc)       \{ errEl.innerHTML='<div class="alert a-err">\uc0\u9888 \u65039  Enter a description.</div>';  return; \}\
  if (!amt||amt<=0)\{ errEl.innerHTML='<div class="alert a-err">\uc0\u9888 \u65039  Enter a valid amount.</div>'; return; \}\
\
  const dpRem    = diningPointsRemaining();\
  const dpUsed   = Math.min(amt, Math.max(dpRem, 0));\
  const overflow = parseFloat(Math.max(amt - dpUsed, 0).toFixed(2));\
  const foodCat  = overflow > 0 ? findFoodCategory() : null;\
\
  // Create the overflow allowance transaction first so we have its ID\
  let overflowTxnId = null;\
  if (overflow > 0.005 && foodCat) \{\
    overflowTxnId = genId('t');\
    S.transactions.push(\{\
      id: overflowTxnId, categoryId: foodCat.id,\
      amount: overflow, description: `$\{desc\} (dining overflow)`,\
      date: new Date().toISOString(), isDiningOverflow: true,\
    \});\
  \}\
\
  S.diningTransactions.push(\{\
    id: genId('d'), description: desc, totalAmount: amt,\
    diningPointsUsed: dpUsed, overflowAmount: overflow,\
    overflowCatId: foodCat?.id || null,\
    overflowTxnId: overflowTxnId,\
    date: new Date().toISOString()\
  \});\
\
  save(); renderDashboard(); closeModal('m-expense');\
\
  if (overflow > 0.005) \{\
    toast(`\uc0\u55356 \u57213 \u65039  $\{dpUsed.toFixed(2)\} pts + $$\{overflow.toFixed(2)\} from $\{foodCat?.name||'Food'\}`);\
  \} else \{\
    toast(`\uc0\u55356 \u57213 \u65039  $\{dpUsed.toFixed(2)\} pts used \'97 $\{diningPointsRemaining().toFixed(2)\} pts left`);\
  \}\
\}\
\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
// EARNINGS\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
function submitEarning() \{\
  const desc  = document.getElementById('earn-desc').value.trim();\
  const amt   = parseFloat(document.getElementById('earn-amt').value);\
  const errEl = document.getElementById('earn-err');\
  errEl.innerHTML = '';\
  if (!desc)       \{ errEl.innerHTML='<div class="alert a-err">\uc0\u9888 \u65039  Enter a description.</div>';  return; \}\
  if (!amt||amt<=0)\{ errEl.innerHTML='<div class="alert a-err">\uc0\u9888 \u65039  Enter a valid amount.</div>'; return; \}\
\
  S.earnings.push(\{ id:genId('e'), amount:amt, description:desc, date:new Date().toISOString() \});\
  save(); renderDashboard(); closeModal('m-earning');\
  toast(`\uc0\u55357 \u56520  +$$\{amt.toFixed(2)\} added! Total assets \u8594  $$\{totalAssets().toFixed(2)\}`);\
\}\
\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
// DELETIONS\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
function deleteTxn(id) \{\
  const t = S.transactions.find(x=>x.id===id);\
  if (t?.isDiningOverflow) \{\
    toast('\uc0\u9888 \u65039  Delete the dining entry instead to remove this overflow.'); return;\
  \}\
  confirmDo('Delete Expense?','Budget amount will be restored.',() => \{\
    S.transactions = S.transactions.filter(t=>t.id!==id);\
    save(); renderDashboard(); toast('\uc0\u55357 \u56785 \u65039  Expense deleted');\
  \});\
\}\
\
function deleteDiningTxn(id) \{\
  confirmDo('Delete Dining Entry?','Dining points and any food overflow will be restored.',() => \{\
    const dt = S.diningTransactions.find(t=>t.id===id);\
    // Remove linked overflow transaction\
    if (dt?.overflowTxnId) \{\
      S.transactions = S.transactions.filter(t=>t.id!==dt.overflowTxnId);\
    \}\
    S.diningTransactions = S.diningTransactions.filter(t=>t.id!==id);\
    save(); renderDashboard(); toast('\uc0\u55357 \u56785 \u65039  Dining entry deleted');\
  \});\
\}\
\
function deleteEarning(id) \{\
  confirmDo('Delete Earning?','This will reduce your total assets.',() => \{\
    S.earnings = S.earnings.filter(e=>e.id!==id);\
    save(); renderDashboard(); toast('\uc0\u55357 \u56785 \u65039  Earning deleted');\
  \});\
\}\
\
function clearAllActivity() \{\
  confirmDo('Clear All Activity?','All transactions, dining entries, and earnings will be removed.',() => \{\
    S.transactions = []; S.diningTransactions = []; S.earnings = [];\
    save(); renderDashboard(); toast('\uc0\u55357 \u56785 \u65039  All activity cleared');\
  \});\
\}\
\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
// NEW MONTH FLOW\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
function showNewMonthSummary() \{\
  const remAllow = remainingAllowance();\
  const earned   = totalEarnings();\
  const savings  = remAllow + earned;\
  const newTotal = S.savedFromPrevMonths + savings;\
\
  document.getElementById('nm-savings-amt').textContent = `$$\{savings.toFixed(2)\}`;\
  document.getElementById('nm-savings-rows').innerHTML = `\
    <div class="nm-sum-row">\
      <span>Unspent allowance</span>\
      <span>$$\{remAllow.toFixed(2)\}</span>\
    </div>\
    <div class="nm-sum-row">\
      <span>This month's earnings</span>\
      <span>$$\{earned.toFixed(2)\}</span>\
    </div>\
    <div class="nm-sum-row" style="border-top:1px solid rgba(255,255,255,.3);\
         margin-top:6px;padding-top:6px;font-weight:700;">\
      <span>Total saved balance</span>\
      <span>$$\{newTotal.toFixed(2)\}</span>\
    </div>\
  `;\
  openModal('m-new-month');\
\}\
\
function confirmNewMonth() \{\
  // Compute savings from this month\
  const thisSavings = remainingAllowance() + totalEarnings();\
\
  // Store last month data for "same as" feature\
  S.lastAllowance    = S.allowance;\
  S.lastDiningPoints = S.diningPoints;\
  S.lastCategories   = JSON.parse(JSON.stringify(S.categories));\
\
  // Accumulate savings\
  S.savedFromPrevMonths += thisSavings;\
\
  // Reset current month\
  S.allowance          = 0;\
  S.diningPoints       = 0;\
  S.monthStart         = '';\
  S.transactions       = [];\
  S.diningTransactions = [];\
  S.earnings           = [];\
\
  save();\
  closeModal('m-new-month');\
  showFab(false);\
\
  // Go to setup with "same as last" pre-shown\
  prepSetupScreen();\
  document.getElementById('inp-allowance').value = '';\
  document.getElementById('inp-dining').value    = '';\
  document.getElementById('s-dot1').className    = 'step active';\
  document.getElementById('s-dot2').className    = 'step';\
  navTo('s-setup');\
  toast(`\uc0\u55357 \u56787 \u65039  Month closed! $$\{thisSavings.toFixed(2)\} added to savings.`);\
\}\
\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
// RECONFIGURE (Edit button)\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
function openReconfigure() \{\
  confirmDo('Edit Budget?',\
    'Update your allowance and category percentages. Current transactions are kept.',\
    () => \{\
      prepSetupScreen();\
      document.getElementById('inp-allowance').value       = S.allowance;\
      document.getElementById('inp-dining').value          = S.diningPoints;\
      document.getElementById('lbl-allowance').textContent = `$$\{S.allowance.toFixed(2)\}`;\
      document.getElementById('alloc-total').textContent   = `$$\{S.allowance.toFixed(2)\}`;\
      document.getElementById('alloc-full').textContent    = `$$\{S.allowance.toFixed(2)\}`;\
      initSetupCats(S.categories);\
      showFab(false);\
      document.getElementById('s-dot1').className = 'step active';\
      document.getElementById('s-dot2').className = 'step';\
      navTo('s-setup');\
    \});\
\}\
\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
// RESET APP\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
function resetApp() \{\
  S = \{ allowance:0, diningPoints:0, monthStart:'', categories:[],\
        transactions:[], diningTransactions:[], earnings:[],\
        savedFromPrevMonths:0, lastAllowance:0, lastDiningPoints:0, lastCategories:[] \};\
  save(); showFab(false);\
  navTo('s-welcome'); toast('App reset complete');\
\}\
\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
// CONFIRM MODAL\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
function confirmDo(title, msg, cb) \{\
  document.getElementById('conf-title').textContent = title;\
  document.getElementById('conf-msg').textContent   = msg;\
  pendingCb = cb;\
  openModal('m-confirm');\
\}\
document.getElementById('conf-btn').addEventListener('click', () => \{\
  if (pendingCb) \{ pendingCb(); pendingCb = null; \}\
  closeModal('m-confirm');\
\});\
\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
// MODAL HELPERS\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
function openModal(id)  \{ document.getElementById(id).classList.add('open'); \}\
function closeModal(id) \{ document.getElementById(id).classList.remove('open'); \}\
function bgClose(e, id) \{\
  if (e.target === document.getElementById(id)) closeModal(id);\
\}\
\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
// UTILITIES\
// \uc0\u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \
function esc(s) \{\
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;')\
                  .replace(/>/g,'&gt;').replace(/"/g,'&quot;');\
\}\
let _tt;\
function toast(msg) \{\
  const el = document.getElementById('toast');\
  clearTimeout(_tt);\
  el.textContent = msg;\
  el.classList.add('show');\
  _tt = setTimeout(() => el.classList.remove('show'), 2900);\
\}\
document.addEventListener('keydown', e => \{\
  if (e.key === 'Escape')\
    ['m-action','m-expense','m-earning','m-new-month','m-confirm']\
      .forEach(id => closeModal(id));\
\});\
\
init();\
\
// Register service worker for PWA / offline support\
if ('serviceWorker' in navigator) \{\
  window.addEventListener('load', () => \{\
    navigator.serviceWorker.register('./sw.js')\
      .then(() => console.log('\uc0\u9989  Service Worker registered'))\
      .catch(err => console.log('SW error:', err));\
  \});\
\}\
